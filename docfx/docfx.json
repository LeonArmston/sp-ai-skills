{
  "build": {
    "content": [
      {
        "files": [
          "toc.yml",
          "*.md"
        ]
      },
      {
        "files": [
          "toc.yml",
          "**.md",
          "**/**.md"
        ],
        "src": "../samples",
        "dest": "samples"
      }
    ],
    "resource": [
      {
        "files": [
          "assets/**"
        ]
      },
      {
        "files": [
          "**/assets/*.png",
          "**/assets/*.jpg",
          "**/assets/*.gif"
        ],
        "src": "../samples",
        "dest": "samples"
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern",
      "templates/sp-skills"
    ],
    "sitemap": {
      "baseUrl": "https://leonarmston.github.io/sp-ai-skills/",
      "priority": 1.0,
      "changefreq": "weekly"
    },
    "globalMetadata": {
      "_appTitle": "SP AI Skills",
      "_appFooter": "<span>SP AI Skills — Community AI Skills for AI in SharePoint<br>Generated by <strong><a href='https://dotnet.github.io/docfx' target='_blank'>DocFX</a></strong> with <strong><a href='https://ovasquez.github.io/docfx-material' target='_blank'>Material UI</a></strong></span>",
      "_appFaviconPath": "https://c.s-microsoft.com/favicon.ico?v2",
      "_appLogoPath": "assets/logo.svg",
      "_appCss": "public/main.css",
      "_description": "Community-contributed AI Skills for AI in SharePoint (Microsoft 365 Copilot).",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableAffix": false,
      "_disableBreadcrumb": false,
      "_gitContribute": {}
    },
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": true,
    "disableGitFeatures": false
  }
}
